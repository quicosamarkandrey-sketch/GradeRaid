{
  "name": "eduquest",
  "version": "1.0.0",
  "private": true,
  "description": "EduQuest \u2014 gamified classroom management app (vanilla JS + Supabase)",
  "scripts": {
    "test": "npm run test:unit && npm run test:smoke",
    "test:unit": "node --test 'tests/unit/**/*.test.js'",
    "test:smoke": "playwright test",
    "test:smoke:headed": "playwright test --headed",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:rewards-db": "node tests/database/learning-rewards.cjs",
    "test:study-db": "node tests/database/study-progress.cjs",
    "test:titles-db": "node tests/database/title-collections.cjs",
    "test:boss-db": "node tests/database/world-boss.cjs",
    "test:boss-browser": "node tests/browser/world-boss.cjs",
    "test:boss-effects": "node tests/browser/world-boss-effects.cjs",
    "test:boss-loot": "node tests/browser/world-boss-loot-race.cjs",
    "test:boss-ultimate-db": "node tests/database/world-boss-ultimate.cjs",
    "test:boss-ultimate": "node tests/browser/world-boss-ultimate.cjs",
    "test:recitation": "node tests/database/recitation-studio.cjs && node tests/browser/recitation-studio.cjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@playwright/test": "^1.48.0",
    "acorn-walk": "^8.3.5",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "jsdom": "^25.0.1"
  }
}
